<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>

<!--
-->

<plugin
      name="%pluginName"
      id="qlstyle-metamodel"
      version="1.0.0"
      provider-name="%providerName">

   <requires>
      <import plugin="org.eclipse.core.runtime"/>
      <import plugin="org.eclipse.emf.ecore" export="true"/>
      <import plugin="questionnaire-metamodel" export="true"/>
   </requires>

   <runtime>
      <library name=".">
         <export name="*"/>
      </library>
   </runtime>

   <extension point="org.eclipse.emf.ecore.generated_package">
      <!-- @generated qlstyle -->
      <package
            uri="http://www.example.org/qlstyle"
            class="org.eclipse.sirius.qlstyle.QLStylePackage"
            genModel="src/main/resources/model/qlstyle.genmodel"/>
   </extension>

</plugin>
